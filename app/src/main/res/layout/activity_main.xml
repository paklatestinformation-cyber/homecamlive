<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="@color/rec"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" HOMECAMLIVE"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btnAbout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_info"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="About" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live camera, kahin se bhi"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECT OPERATION"
        android:textColor="@color/accent"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.14"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp" />

    <!-- Camera mode card -->
    <LinearLayout
        android:id="@+id/cardCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_cam" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAMERA / BROADCAST"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Is phone ko CCTV banayein"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:layout_marginTop="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● LIVE TRANSMIT"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Viewer mode card -->
    <LinearLayout
        android:id="@+id/cardViewer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true">
        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon"
            android:gravity="center">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_eye" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEWER / MONITOR"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Doosre phone ki live dekhein"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp"
                android:layout_marginTop="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶ REMOTE FEED"
                android:textColor="@color/accent"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Room ID card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_room"
        android:padding="14dp"
        android:layout_marginTop="18dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESS CODE / ROOM ID"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <EditText
                android:id="@+id/roomInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@null"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:maxLength="20"
                android:inputType="textCapCharacters"
                android:importantForAutofill="no" />
            <ImageButton
                android:id="@+id/btnRandom"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_refresh"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Random room ID" />
            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy room ID" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dono phones me same ID daalein"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Developed by Muhammad Kamran Malik\n+923135275771"
        android:textColor="@color/text_secondary"
        android:textSize="9.5sp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginTop="16dp" />

    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <!-- Bottom nav -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/line" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_grid" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textColor="@color/accent" android:textSize="10sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_cam" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camera" android:textColor="@color/text_secondary" android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navViewer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_eye" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Viewer" android:textColor="@color/text_secondary" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
