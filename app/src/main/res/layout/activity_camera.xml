<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAMERA / BROADCAST"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/recDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● OFF"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:layout_marginTop="6dp">
        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OFFLINE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/fpsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 fps"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/roomText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOME-XXXX"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/camInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BACK CAM · MIC ON · REC OFF"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <!-- Preview -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_preview"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/previewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Camera preview" />
        <TextView
            android:id="@+id/previewPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Camera shuru ho rahi hai…"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center" />
        <TextView
            android:id="@+id/recBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="● REC"
            android:textColor="@color/rec"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/btnCamFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_expand"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fullscreen" />

        <LinearLayout
            android:id="@+id/dualPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/camBackImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Back camera" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_margin="6dp"
                    android:text="BACK"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/camFrontImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Front camera" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_margin="6dp"
                    android:text="FRONT"
                    android:textColor="@color/accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Camera on karke is phone ko CCTV bana kar stream karein."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">
        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="MIC ON"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnFlip"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="FLIP CAM"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnDual"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="DUAL"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="RECORD"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="START BROADCAST"
        android:textColor="@color/on_accent"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn"
        android:stateListAnimator="@null" />
</LinearLayout>
