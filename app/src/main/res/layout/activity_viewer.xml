<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:padding="16dp">

    <!-- App bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VIEWER / MONITOR"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
        <TextView
            android:id="@+id/connChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp" />
    </LinearLayout>

    <!-- Room input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="6dp">
        <EditText
            android:id="@+id/roomInput"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="ROOM ID"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:maxLength="20"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no" />
        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="CONNECT"
            android:textColor="@color/on_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp" />
    </LinearLayout>

    <!-- Feed -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_preview"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/feedImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Live feed" />
        <TextView
            android:id="@+id/feedPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Camera ka intezaar…"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center" />
        <TextView
            android:id="@+id/liveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:text="● LIVE"
            android:textColor="@color/rec"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/feedFps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="0 fps"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
        <ImageButton
            android:id="@+id/btnFullscreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:src="@drawable/ic_expand"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fullscreen" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/btnSound"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="SOUND ON"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnFlipCam"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="FLIP CAM"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp" />
        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="RECORD"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_outline"
            android:stateListAnimator="@null"
            android:minWidth="0dp"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/viewerInfoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AUDIO ON · REC OFF"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dono phones me same Room ID aur internet hona chahiye."
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:gravity="center"
        android:layout_marginTop="10dp" />
</LinearLayout>
